AERIALOPS_ENVIRONMENT=development
AERIALOPS_LOG_LEVEL=INFO
AERIALOPS_FRONTEND_ORIGIN=http://localhost:3000
AERIALOPS_API_HOST=127.0.0.1
AERIALOPS_API_PORT=8000
AERIALOPS_DATABASE_URL=postgresql+psycopg://aerialops:aerialops@127.0.0.1:5432/aerialops?connect_timeout=2

# Keep deterministic for zero-secret local development. Set to gemini or openai,
# then provide the matching API key below.
AERIALOPS_AGENT_PROVIDER=deterministic
AERIALOPS_AGENT_MODEL=gemini-3.1-flash-lite
AERIALOPS_AGENT_TIMEOUT_SECONDS=20
AERIALOPS_AGENT_MAX_OUTPUT_TOKENS=900
# OPENAI_API_KEY=
# GEMINI_API_KEY=

# Disabled by default: enabling Gemini vision sends uploaded images to that provider.
AERIALOPS_VISION_PROVIDER=disabled
AERIALOPS_VISION_MODEL=gemini-3.1-flash-lite
