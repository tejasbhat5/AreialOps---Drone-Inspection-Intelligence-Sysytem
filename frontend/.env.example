# Used by the Next.js server to reach FastAPI.
API_BASE_URL=http://127.0.0.1:8000

# Browser-visible URL for future client-side requests. Never put secrets here.
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000

# Browser tile source. Production deployments should select a provider with an appropriate SLA.
NEXT_PUBLIC_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
